{
  "doctype": "DocType",
  "name": "PackDesign Component",
  "module": "VIAS PackDesign",
  "custom": 0,
  "istable": 1,
  "editable_grid": 1,
  "fields": [
    { "fieldname": "layer_name", "label": "Nombre de Capa", "fieldtype": "Data", "reqd": 1, "in_list_view": 1 },
