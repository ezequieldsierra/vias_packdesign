    { "fieldname": "visible", "label": "Visible", "fieldtype": "Check", "default": "1", "in_list_view": 1 },
    { "fieldname": "color", "label": "Color (HEX)", "fieldtype": "Color" },
    { "fieldname": "line_width", "label": "Ancho de Línea (pt)", "fieldtype": "Float" },
